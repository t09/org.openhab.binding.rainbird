<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bindingId="rainbird"
        xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

        <channel-type id="networkUp">
                <item-type>Switch</item-type>
                <label>@text/channel-type.rainbird.networkUp.label</label>
                <description>@text/channel-type.rainbird.networkUp.description</description>
                <category>Network</category>
                <tags>
                        <tag>Control</tag>
                </tags>
                <state readOnly="false"/>
        </channel-type>


        <channel-type id="internetUp">
                <item-type>Switch</item-type>
                <label>@text/channel-type.rainbird.internetUp.label</label>
                <description>@text/channel-type.rainbird.internetUp.description</description>
                <category>Network</category>
                <state readOnly="true"/>
        </channel-type>

        <channel-type id="wifiSignal">
                <item-type>Number:Dimensionless</item-type>
                <label>@text/channel-type.rainbird.wifiSignal.label</label>
                <description>@text/channel-type.rainbird.wifiSignal.description</description>
                <category>Network</category>
                <state readOnly="true" pattern="%.0f %%"/>
        </channel-type>

        <channel-type id="wifiSsid">
                <item-type>String</item-type>
                <label>@text/channel-type.rainbird.wifiSsid.label</label>
                <description>@text/channel-type.rainbird.wifiSsid.description</description>
                <category>Text</category>
                <state readOnly="true"/>
        </channel-type>

        <channel-type id="wifiMac">
                <item-type>String</item-type>
                <label>@text/channel-type.rainbird.wifiMac.label</label>
                <description>@text/channel-type.rainbird.wifiMac.description</description>
                <category>Text</category>
                <state readOnly="true"/>
        </channel-type>

        <channel-type id="zoneCount">
                <item-type>Number</item-type>
                <label>@text/channel-type.rainbird.zoneCount.label</label>
                <description>@text/channel-type.rainbird.zoneCount.description</description>
                <category>Number</category>
                <state readOnly="true" pattern="%.0f"/>
        </channel-type>

        <channel-type id="programCount">
                <item-type>Number</item-type>
                <label>@text/channel-type.rainbird.programCount.label</label>
                <description>@text/channel-type.rainbird.programCount.description</description>
                <category>Number</category>
                <state readOnly="true" pattern="%.0f"/>
        </channel-type>

        <channel-type id="scheduleSummary">
                <item-type>String</item-type>
                <label>@text/channel-type.rainbird.scheduleSummary.label</label>
                <description>@text/channel-type.rainbird.scheduleSummary.description</description>
                <category>Text</category>
                <state readOnly="true"/>
        </channel-type>

        <channel-type id="controllerTime">
                <item-type>DateTime</item-type>
                <label>@text/channel-type.rainbird.controllerTime.label</label>
                <description>@text/channel-type.rainbird.controllerTime.description</description>
                <category>Time</category>
                <state readOnly="true"/>
        </channel-type>

        <channel-type id="rainDelay">
                <item-type>Number:Time</item-type>
                <label>@text/channel-type.rainbird.rainDelay.label</label>
                <description>@text/channel-type.rainbird.rainDelay.description</description>
                <category>Time</category>
                <state readOnly="true" pattern="%.0f d"/>
        </channel-type>

        <channel-type id="seasonalAdjust">
                <item-type>Number:Dimensionless</item-type>
                <label>@text/channel-type.rainbird.seasonalAdjust.label</label>
                <description>@text/channel-type.rainbird.seasonalAdjust.description</description>
                <category>Settings</category>
                <state readOnly="true" pattern="%.0f %%"/>
        </channel-type>

        <channel-type id="activeStation">
                <item-type>Number</item-type>
                <label>@text/channel-type.rainbird.activeStation.label</label>
                <description>@text/channel-type.rainbird.activeStation.description</description>
                <category>Number</category>
                <state readOnly="true" pattern="%.0f">
                   <options>
                      <option value="0">AUS</option>
                      <option value="1">EIN</option>
                   </options>
                </state>
        </channel-type>

        <channel-type id="lastPoll">
                <item-type>DateTime</item-type>
                <label>@text/channel-type.rainbird.lastPoll.label</label>
                <description>@text/channel-type.rainbird.lastPoll.description</description>
                <category>Time</category>
                <state readOnly="true"/>
        </channel-type>

        <channel-type id="programSelector">
                <item-type>String</item-type>
                <label>@text/channel-type.rainbird.programSelector.label</label>
                <description>@text/channel-type.rainbird.programSelector.description</description>
                <category>Control</category>
                <state>
                        <options>
                                <option value="A">Program A</option>
                                <option value="B">Program B</option>
                                <option value="C">Program C</option>
                                <option value="STOP">Stop All Programs</option>
                        </options>
                </state>
        </channel-type>

        <channel-type id="manualZoneSelector">
                <item-type>String</item-type>
                <label>@text/channel-type.rainbird.manualZoneSelector.label</label>
                <description>@text/channel-type.rainbird.manualZoneSelector.description</description>
                <category>Control</category>
        </channel-type>

        <channel-type id="zoneActive">
                <item-type>Switch</item-type>
                <label>@text/channel-type.rainbird.zoneActive.label</label>
                <description>@text/channel-type.rainbird.zoneActive.description</description>
                <category>Water</category>
                <tags>
                        <tag>Control</tag>
                </tags>
                <state readOnly="false"/>
        </channel-type>

        <channel-type id="zoneDuration">
                <item-type>Number</item-type>
                <label>@text/channel-type.rainbird.zoneDuration.label</label>
                <description>Requested manual watering duration for this zone in seconds.</description>
                <category>Time</category>
                                <tags>
                        <tag>Control</tag>
                </tags>
                <state readOnly="false" min="60" max="5940" step="60" pattern="%d s"/>
        </channel-type>

        <channel-type id="zoneRemaining">
                <item-type>Number</item-type>
                <label>@text/channel-type.rainbird.zoneRemaining.label</label>
                <description>Remaining manual watering duration for this zone in seconds.</description>
                <category>Time</category>
                                <tags>
                        <tag>Status</tag>
                </tags>
                <state readOnly="true" pattern="%d s"/>
        </channel-type>

        <channel-type id="switch">
                <item-type>Switch</item-type>
                <label>@text/channel-type.rainbird.switch.label</label>
                <description>@text/channel-type.rainbird.switch.description</description>
                <category>Switch</category>
        </channel-type>

        <channel-type id="remainingTime">
                <item-type>Number:Time</item-type>
                <label>@text/channel-type.rainbird.remainingTime.label</label>
                <description>@text/channel-type.rainbird.remainingTime.description</description>
                <category>Time</category>
                <state readOnly="true" pattern="%.0f s"/>
        </channel-type>

        <channel-type id="flow">
                <item-type>Number:FlowRate</item-type>
                <label>@text/channel-type.rainbird.flow.label</label>
                <description>@text/channel-type.rainbird.flow.description</description>
                <category>Flow</category>
                <state readOnly="true"/>
        </channel-type>

</thing:thing-descriptions>
